# ---------------------------------------------------------------------------
# OJASVI — environment
#
# Tuned for Hostinger shared hosting: no Redis, no daemon processes, no Node on
# the server. Queues, cache and sessions all live in MySQL, and the scheduler
# and queue are driven by a single cron entry (see DEPLOYMENT.md).
# ---------------------------------------------------------------------------
APP_NAME=OJASVI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ojasvidrapes.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Hostinger gives you these in hPanel → Databases → Management.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared hosting has no Redis and no supervisor, so everything goes in MySQL.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Writing a log file per day keeps a shared account's disk use predictable.
LOG_CHANNEL=daily
LOG_LEVEL=error

# Hostinger's SMTP, or your own. Orders will not email without this.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@ojasvidrapes.in
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay — Dashboard → Account & Settings → API Keys.
# Use the rzp_test_ keys until you have placed a real order end to end.
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Dashboard → Webhooks. Point it at /webhooks/razorpay and copy the secret here.
RAZORPAY_WEBHOOK_SECRET=

# Delhivery — for tracking numbers and delivery status on each order.
DELHIVERY_TOKEN=
DELHIVERY_BASE=https://track.delhivery.com
# Exactly as the warehouse is named in the Delhivery panel — a booking is
# refused outright if this does not match, character for character.
DELHIVERY_PICKUP_NAME=

# The spend that earns free shipping, in rupees. Shown on the site and used by
# the progress meter, so there is only ever one figure.
SHOP_FREE_SHIPPING_FROM=2999
SHOP_CURRENCY=INR

# Set this to true only on a host that forbids symlinks, where
# `php artisan storage:link` cannot run. Uploads then go straight into
# public/uploads instead of needing the link. See DEPLOYMENT.md.
SHOP_UPLOADS_IN_PUBLIC=false

# Or off this box altogether, on DigitalOcean Spaces. Worth it when the shop
# outgrows a shared host's disk, or wants its photographs served from a CDN —
# and it ends the symlink business above, since nothing is kept here to link
# to. The paths stored against each saree do not change, so moving is copying
# the files up and setting this to true. See DEPLOYMENT.md.
SHOP_UPLOADS_ON_SPACES=false
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
# blr1 is Bangalore. The shop sells in India; its photographs should not travel
# to Amsterdam and back for somebody in Hyderabad.
SPACES_REGION=blr1
# The CDN address, if the Space has one switched on. Without it the files are
# served straight from the Space, which works and is slower.
SPACES_URL=

# The admin account `php artisan db:seed` creates. Put a real password here
# before running it — at least 8 characters. Left blank, no admin is made,
# because an account with an empty password is one nobody can ever sign in to.
# You can also set it afterwards with `php artisan ojasvi:admin`.
ADMIN_NAME=OJASVI
ADMIN_EMAIL=admin@ojasvidrapes.in
ADMIN_PASSWORD=
